# Public base URL used for canonical URLs and the sitemap.
PUBLIC_SITE_URL=https://your-funnel-site.pages.dev

# Fallback used only when managed checkout is explicitly disabled.
PUBLIC_CHECKOUT_URL=https://checkout.example.com/your-offer

# Managed checkout is enabled by default for Dodo and Stripe. Set this to false only for an
# intentional maintenance window after confirming the fallback URL above.
PUBLIC_MANAGED_CHECKOUT_ENABLED=true

# Private payment settings. The local setup screen saves these to .dev.vars;
# keep one provider selected and leave the other provider's placeholders unused.
PAYMENTS_PROVIDER=dodo
DODO_PAYMENTS_API_KEY=your_private_dodo_key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=your_private_dodo_webhook_key
STRIPE_SECRET_KEY=sk_test_your_private_stripe_key
STRIPE_PAYMENTS_ENVIRONMENT=test_mode
STRIPE_WEBHOOK_SECRET=whsec_your_private_stripe_webhook_secret

# Postmark sends transactional purchase access and opted-in broadcasts. Stripe
# requires transactional email; it remains optional with Dodo native delivery.
POSTMARK_SERVER_TOKEN=your_private_postmark_server_token
EMAIL_TRANSACTIONAL_FROM=Access <access@yourdomain.com>
EMAIL_MARKETING_FROM=Updates <updates@yourdomain.com>
EMAIL_REPLY_TO=help@yourdomain.com
EMAIL_PURCHASE_TEMPLATE_ALIAS=purchase-access
EMAIL_SENDER_NAME=Your Company
EMAIL_POSTAL_ADDRESS=123 Main Street, City, State ZIP
EMAIL_OPERATOR_SECRET=generate_a_random_32_byte_secret
EMAIL_UNSUBSCRIBE_SECRET=generate_a_different_random_32_byte_secret
POSTMARK_WEBHOOK_USERNAME=postmark
POSTMARK_WEBHOOK_PASSWORD=generate_a_third_random_32_byte_secret
SUPPORT_EMAIL=help@yourdomain.com

# Admaxxer first-party analytics and revenue attribution. Copy the website ID
# from Admaxxer → Pixel, and use the exact public hostname for this funnel.
PUBLIC_ADMAXXER_WEBSITE_ID=your_admaxxer_website_id
PUBLIC_ADMAXXER_DOMAIN=shop.example.com
# Optional. Leave unset to use Admaxxer's hosted pixel script.
# PUBLIC_ADMAXXER_SCRIPT_URL=https://admaxxer.com/js/script.js

# Private workspace API key used only by verified payment webhooks to send
# successful payments to Admaxxer's server-side Payments API.
ADMAXXER_API_KEY=your_private_admaxxer_workspace_key
