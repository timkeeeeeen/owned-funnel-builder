# Public base URL used for canonical URLs and the sitemap.
PUBLIC_SITE_URL=https://maestro-offers.pages.dev

# Safe fallback used until Dodo inline checkout is fully configured.
PUBLIC_VIBE_CODE_CHECKOUT_URL=https://checkout.example.com/vibe-code-anything

# Enable only after the Dodo API key, environment, and offer product ID are set as
# Cloudflare Pages secrets and the production checkout has been tested end to end.
PUBLIC_VIBE_CODE_DODO_CHECKOUT_ENABLED=false
