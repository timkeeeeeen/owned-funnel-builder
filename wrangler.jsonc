{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "owned-funnel-builder",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist/client",
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "owned-funnel-builder",
      "database_id": "f37a6e92-fcc6-43fd-898c-e8a7bf87767f",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "LEADS",
          "database_name": "owned-funnel-builder-preview",
          "database_id": "fd9f29b7-3b15-4655-a72c-f2fe73e54c24",
          "migrations_dir": "migrations",
        },
      ],
      "services": [
        {
          "binding": "TRACKING_SOURCE_BRIDGE",
          "service": "maestro-first-party-events",
        },
      ],
    },
  },
}
