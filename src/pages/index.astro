---
import OfferLayout from '@/layouts/OfferLayout.astro';
import { publishedOffers } from '@/data/offers';
import { siteSettings } from '@/data/site';

const title = siteSettings.siteName;
const description = siteSettings.homeDescription;
const siteInitial = siteSettings.shortName.trim().charAt(0).toUpperCase() || 'O';
---

<OfferLayout title={title} description={description} image={siteSettings.defaultImage}>
  <div class="offer-grid min-h-screen px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <header class="flex items-center gap-3">
        <span
          class="grid size-12 place-items-center rounded-xl bg-foreground font-mono text-xl font-bold text-background"
          aria-hidden="true">{siteInitial}</span
        >
        <span class="font-bold uppercase tracking-[0.16em]">{siteSettings.siteName}</span>
      </header>

      <section class="py-20" aria-labelledby="offers-title">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
          {siteSettings.homeEyebrow}
        </p>
        <h1
          id="offers-title"
          class="mt-4 max-w-5xl text-balance text-6xl font-bold leading-[0.92] tracking-[-0.055em] md:text-8xl"
        >
          {siteSettings.homeHeadline}<br /><mark class="offer-mark">{siteSettings.homeAccent}</mark>
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-muted-foreground">
          {siteSettings.homeDescription}
        </p>
      </section>

      <section class="pb-20" aria-labelledby="available-title">
        <h2 id="available-title" class="text-3xl font-bold md:text-5xl">Available now</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {
            publishedOffers.map((offer) => (
              <article class="rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
                <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
                  {offer.productName}
                </p>
                <h3 class="mt-4 text-4xl font-semibold tracking-tight">
                  {offer.headline} {offer.headlineAccent}
                </h3>
                <p class="mt-4 leading-relaxed text-muted-foreground">{offer.subheadline}</p>
                <div class="mt-8 flex items-center justify-between gap-4">
                  <span class="text-3xl font-bold">{offer.currentPrice}</span>
                  <a
                    href={`/${offer.slug}/`}
                    class="offer-cta inline-flex min-h-14 items-center justify-center rounded-xl bg-brand px-6 py-4 font-bold text-brand-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    See the offer →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</OfferLayout>
