    'Service economics',
    'Cost per qualified held call ≤ (close rate × project gross profit) ÷ 3',
    'Pause traffic and repair sales/offer if calls qualify but do not close',
    'No credible 3× contribution path',
  ],
];

const sequence = [
  {
    window: 'Days 1–5',
    title: 'Sell Launch Rescue before building software',
    actions: [
      'Publish one direct-to-call page and one eight-question diagnosis.',
      'Interview five stuck founders; use their exact failure language in the page.',
      'Offer a manually delivered $49 audit to anyone not ready for a sprint.',
    ],
  },
  {
    window: 'Days 6–12',
    title: 'Run the first clean traffic test',
    actions: [
      'Test three creatives: half-built app, launch-readiness gap, and first-customer gap.',
      'Keep one audience and one page so creative is the main variable.',
      'Do not decide before 300 landing-page views unless there is zero meaningful action after 150.',
    ],
  },
  {
    window: 'Days 13–20',
    title: 'Validate the Maestro-led lane manually',
    actions: [
      'Create three source-backed sample packets from approved calls or supplied sample data.',
      'Sell the outcome as a cited growth system, not as generic AI-brain consulting.',
      'Record which two workflows buyers actually request before expanding Maestro’s promise.',
    ],
  },
  {
    window: 'Days 21–30',
    title: 'Choose the business, then automate the repetition',
    actions: [
      'Scale only the offer with qualified demand and a credible delivery margin.',
      'Turn repeated audit steps into Vibe Launch Doctor or AI Brain Auditor features.',
      'Add ads management only after one offer/funnel pair converts and tracking is trusted.',
    ],
  },
];

const linkClass =
  'inline-flex min-h-11 items-center rounded-lg bg-secondary px-3 py-2 font-semibold text-secondary-foreground underline decoration-border underline-offset-4 transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring';
---

<OfferLayout
  title="Market Opportunity Plan — Maestro"
  description="A private, evidence-led offer and funnel test plan for Maestro, owned funnels, services, and adjacent products."
  noindex={true}
>
  <div class="offer-grid min-h-screen">
    <header class="px-4 pb-16 pt-6 sm:px-6 md:px-12 md:pb-24">
      <div class="mx-auto max-w-7xl">
        <nav aria-label="Plan sections" class="flex flex-wrap items-center gap-2">
          <a
            href="#main-plan"
            class="mr-2 inline-flex min-h-11 items-center rounded-lg bg-foreground px-4 py-2 font-mono text-sm font-bold uppercase tracking-[0.14em] text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            Maestro / market plan
          </a>
          {
            navItems.map(([href, label]) => (
              <a href={href} class={linkClass}>
                {label}
              </a>
            ))
          }
        </nav>

        <div id="main-plan" class="pt-20 md:pt-28">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            US Meta research · decision page · August 4, 2026
          </p>
          <h1
            class="mt-5 max-w-6xl text-balance text-5xl font-bold leading-[0.95] tracking-[-0.05em] md:text-7xl"
          >
            The market is buying bounded outcomes—<mark class="offer-mark"
              >not generic services.</mark
            >
          </h1>
          <p class="mt-8 max-w-3xl text-xl leading-relaxed text-muted-foreground md:text-2xl">
            Lead with a productized <strong class="text-foreground">Launch Rescue</strong> for stuck app
            founders. Build a second, Maestro-powered <strong class="text-foreground"
              >Source-Backed Growth System</strong
            > for agencies, consultants, and founder-led teams. Web development, funnels, ads, and AI-brain
            work become the delivery stack—not four vague offers.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="#tests"
              class="offer-cta inline-flex min-h-14 items-center rounded-xl bg-brand px-6 py-4 font-bold text-brand-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              See the test order →
            </a>
            <a href="#evidence" class={linkClass}>Open the live-funnel evidence</a>
          </div>
        </div>
      </div>
    </header>

    <div>
      <section
        id="recommendation"
        class="bg-foreground px-4 py-20 text-background sm:px-6 md:px-12"
        aria-labelledby="recommendation-title"
      >
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand-soft">
            Executive recommendation
          </p>
          <h2
            id="recommendation-title"
            class="mt-4 max-w-5xl text-balance text-4xl font-bold tracking-[-0.035em] md:text-6xl"
          >
            Be the team that gets an unfinished asset to revenue—not another agency with a long
            menu.
          </h2>
          <div class="mt-12 grid gap-6 lg:grid-cols-2">
            {
              offerLadders.map((ladder, index) => (
                <article class="rounded-2xl bg-background p-6 text-foreground shadow-sm sm:p-8">
                  <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
                    {index === 0 ? 'Lead offer' : 'Maestro-led offer'}
                  </p>
                  <h3 class="mt-3 text-3xl font-semibold tracking-tight">{ladder.lane}</h3>
                  <p class="mt-4 leading-relaxed text-muted-foreground">{ladder.promise}</p>
                  <div class="mt-6 rounded-xl bg-muted p-5">
                    <p class="text-lg font-bold">{ladder.headline}</p>
                    <p class="mt-2 text-sm text-muted-foreground">Primary action: {ladder.cta}</p>
                  </div>
                </article>
              ))
            }
          </div>
          <div
            class="mt-8 rounded-2xl border border-brand-soft bg-background p-6 text-foreground sm:p-8"
          >
            <h3 class="text-2xl font-semibold">Dev agent or ads/funnel agency?</h3>
            <p class="mt-3 max-w-5xl text-lg leading-relaxed text-muted-foreground">
              Start as the <strong class="text-foreground"
                >productized development and launch-rescue studio</strong
              >. It is more differentiated, easier to scope around an existing artifact, and
              naturally creates the funnel and acquisition work. Add funnel implementation inside
              the sprint. Offer a bounded paid-acquisition pilot only after the message and
              conversion path are credible. A generic ads-management agency would make you
              accountable for broken offers you did not control.
            </p>
          </div>
        </div>
      </section>

      <section id="demand" class="px-4 py-20 sm:px-6 md:px-12" aria-labelledby="demand-title">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Observed demand
          </p>
          <h2
            id="demand-title"
            class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            What the market appears to want
          </h2>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            The repeated pattern is speed plus a boundary: five days, two weeks, 30 days, one
            workflow, one score, one fixed outcome. Buyers are offered implementation, a tangible
            sample, or a diagnostic—not “access to expertise.”
          </p>

          <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-5">
            {
              researchStats.map((stat) => (
                <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
                  <p class="text-3xl font-bold tabular-nums md:text-4xl">{stat.value}</p>
                  <p class="mt-2 text-sm leading-snug text-muted-foreground">{stat.label}</p>
                </div>
              ))
            }
          </div>

          <aside
            class="mt-6 rounded-xl border border-guarantee-border bg-guarantee p-5 text-guarantee-foreground"
          >
            <p class="font-bold">Evidence boundary</p>
            <p class="mt-2 leading-relaxed">
              Active status, days running, multiple ads, and reachable pages are <strong
                >persistence signals, not verified profitability</strong
              >. Meta's public library does not expose spend, purchases, profit, or ROAS. Counts
              below come from a deliberately targeted sample and are not market-share estimates.
            </p>
          </aside>

          <div
            class="mt-12 overflow-x-auto rounded-xl border border-border bg-card shadow-sm"
            data-scroll-region
            tabindex="0"
            role="region"
            aria-label="Funnel pattern comparison"
          >
            <table class="w-full min-w-[760px] border-collapse text-left">
              <caption class="sr-only">Funnel patterns in the 150-live-page research sample</caption
              >
              <thead class="bg-muted">
                <tr>
                  <th scope="col" class="p-4 font-semibold">Funnel pattern</th>
                  <th scope="col" class="p-4 font-semibold">Live rows</th>
                  <th scope="col" class="p-4 font-semibold">Median active</th>
                  <th scope="col" class="p-4 font-semibold">Strategic read</th>
                </tr>
              </thead>
              <tbody>
                {
                  funnelSignals.map((row) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-4 font-semibold">{row.funnel}</td>
                      <td class="p-4 font-mono tabular-nums">{row.count}</td>
                      <td class="p-4">{row.median}</td>
                      <td class="p-4 leading-relaxed text-muted-foreground">{row.read}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {
              marketSignals.map((item) => (
                <article class="rounded-xl border border-border bg-card p-6 shadow-sm">
                  <h3 class="text-2xl font-semibold">{item.capability}</h3>
                  <p class="mt-4 text-sm font-bold uppercase tracking-[0.1em] text-brand">
                    Observed signal
                  </p>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.signal}</p>
                  <p class="mt-5 text-sm font-bold uppercase tracking-[0.1em] text-brand">
                    What buyers are asking for
                  </p>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.wants}</p>
                  <p class="mt-5 text-sm font-bold uppercase tracking-[0.1em] text-brand">
                    Recommendation
                  </p>
                  <p class="mt-2 leading-relaxed">{item.sell}</p>
                </article>
              ))
            }
          </div>

          <div class="mt-10 grid gap-6 lg:grid-cols-2">
            <article class="rounded-xl border border-border bg-card p-6 shadow-sm">
              <h3 class="text-2xl font-semibold">Curious Coder / Apify</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">
                Best for inexpensive bulk discovery, exact ad IDs, creative URLs, landing URLs, and
                raw copy. The deep plus pilot runs produced 3,275 rows for about $2.46. Weaknesses:
                dynamic-creative placeholders, noisy price extraction, duplicates, and the need to
                validate redirects and relevance yourself.
              </p>
            </article>
            <article class="rounded-xl border border-border bg-card p-6 shadow-sm">
              <h3 class="text-2xl font-semibold">AdKit</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">
                Best for keeping selected advertisers attached to Maestro and handing them into an
                ongoing scan/research workflow. Twenty-six new advertisers were queued and three
                matched existing records; scans were still pending. It is less useful than the raw
                scraper for fast, exhaustive first-pass discovery.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section
        id="portfolio"
        class="section-muted px-4 py-20 sm:px-6 md:px-12"
        aria-labelledby="portfolio-title"
      >
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Current portfolio
          </p>
          <h2
            id="portfolio-title"
            class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            The checkout products exist. The service bridges do not.
          </h2>
          <div
            class="mt-10 overflow-x-auto rounded-xl border border-border bg-card shadow-sm"
            data-scroll-region
            tabindex="0"
            role="region"
            aria-label="Existing funnel portfolio"
          >
            <table class="w-full min-w-[980px] border-collapse text-left">
              <caption class="sr-only"
                >Existing funnel portfolio and missing acquisition bridges</caption
              >
              <thead class="bg-background">
                <tr>
                  <th scope="col" class="p-4 font-semibold">Offer</th>
                  <th scope="col" class="p-4 font-semibold">Funnel</th>
                  <th scope="col" class="p-4 font-semibold">Entry</th>
                  <th scope="col" class="p-4 font-semibold">Current truth</th>
                  <th scope="col" class="p-4 font-semibold">Next gap</th>
                </tr>
              </thead>
              <tbody>
                {
                  currentFunnels.map((row) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-4 font-semibold">{row.offer}</td>
                      <td class="p-4">{row.mode}</td>
                      <td class="p-4">{row.entry}</td>
                      <td class="p-4 leading-relaxed text-muted-foreground">{row.truth}</td>
                      <td class="p-4 leading-relaxed">{row.gap}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="mt-12 grid gap-8 lg:grid-cols-2">
            {
              offerLadders.map((ladder) => (
                <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                  <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
                    Offer ladder
                  </p>
                  <h3 class="mt-3 text-3xl font-semibold">{ladder.lane}</h3>
                  <p class="mt-3 leading-relaxed text-muted-foreground">{ladder.buyer}</p>
                  <ol class="mt-8 space-y-5">
                    {ladder.steps.map(([stage, offer, description], index) => (
                      <li class="grid grid-cols-[2.5rem_1fr] gap-3">
                        <span
                          class="grid size-10 place-items-center rounded-full bg-foreground font-mono font-bold text-background"
                          aria-hidden="true"
                        >
                          {index + 1}
                        </span>
                        <div>
                          <p class="font-mono text-sm font-bold uppercase tracking-[0.12em] text-brand">
                            {stage}
                          </p>
                          <p class="mt-1 text-lg font-semibold">{offer}</p>
                          <p class="mt-1 leading-relaxed text-muted-foreground">{description}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="tests" class="px-4 py-20 sm:px-6 md:px-12" aria-labelledby="tests-title">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Prioritized experiments
          </p>
          <h2
            id="tests-title"
            class="mt-4 max-w-5xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            Test service demand first. Build software from paid repetition.
          </h2>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            Run priorities 1–4 before expanding the portfolio. Each test has one buyer, one promise,
            one conversion event, and a decision rule. Prices are hypotheses until scope, margin,
            and delivery capacity are confirmed.
          </p>

          <div class="mt-10 space-y-6">
            {
              experiments.map((test) => (
                <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div>
                      <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
                        Priority {test.priority} · {test.funnel}
                      </p>
                      <h3 class="mt-2 text-3xl font-semibold tracking-tight">{test.offer}</h3>
                      <p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground">
                        {test.audience}
                      </p>
                    </div>
                    <span class="inline-flex min-h-11 items-center self-start rounded-full bg-highlight px-4 py-2 font-semibold text-highlight-foreground">
                      Test {test.priority}
                    </span>
                  </div>
                  <div class="mt-6 grid gap-4 lg:grid-cols-3">
                    <div class="rounded-xl bg-muted p-5">
                      <p class="text-sm font-bold uppercase tracking-[0.1em] text-brand">Build</p>
                      <p class="mt-2 leading-relaxed">{test.build}</p>
                    </div>
                    <div class="rounded-xl bg-muted p-5">
                      <p class="text-sm font-bold uppercase tracking-[0.1em] text-brand">
                        Ad angle
                      </p>
                      <p class="mt-2 leading-relaxed">{test.angle}</p>
                    </div>
                    <div class="rounded-xl bg-muted p-5">
                      <p class="text-sm font-bold uppercase tracking-[0.1em] text-brand">
                        Pass rule
                      </p>
                      <p class="mt-2 leading-relaxed">{test.pass}</p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <div
            class="mt-12 overflow-x-auto rounded-xl border border-border bg-card shadow-sm"
            data-scroll-region
            tabindex="0"
            role="region"
            aria-label="Funnel test decision thresholds"
          >
            <table class="w-full min-w-[900px] border-collapse text-left">
              <caption class="sr-only"
                >Shared pass, iterate, and kill rules for funnel tests</caption
              >
              <thead class="bg-muted">
                <tr>
                  <th scope="col" class="p-4 font-semibold">Funnel</th>
                  <th scope="col" class="p-4 font-semibold">Pass</th>
                  <th scope="col" class="p-4 font-semibold">Iterate</th>
                  <th scope="col" class="p-4 font-semibold">Kill / pause</th>
                </tr>
              </thead>
              <tbody>
                {
                  thresholds.map(([funnel, pass, iterate, kill]) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-4 font-semibold">{funnel}</td>
                      <td class="p-4 text-success">{pass}</td>
                      <td class="p-4">{iterate}</td>
                      <td class="p-4 text-destructive">{kill}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
            These are initial decision thresholds, not universal benchmarks. Track landing-page
            views—not link clicks—and diagnose creative separately from page conversion. A cheap
            lead that never qualifies is a failed test.
          </p>
        </div>
      </section>

      <section
        class="bg-foreground px-4 py-20 text-background sm:px-6 md:px-12"
        aria-labelledby="services-title"
      >
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand-soft">
            Service decisions
          </p>
          <h2
            id="services-title"
            class="mt-4 max-w-5xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            Keep all four capabilities. Change what the customer thinks they are buying.
          </h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {
              serviceDecisions.map((item) => (
                <article class="rounded-2xl bg-background p-6 text-foreground shadow-sm sm:p-8">
                  <p class="font-mono text-sm font-bold uppercase tracking-[0.14em] text-brand">
                    {item.service}
                  </p>
                  <h3 class="mt-3 text-2xl font-semibold">{item.verdict}</h3>
                  <p class="mt-5 font-semibold">Package</p>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.offer}</p>
                  <p class="mt-5 font-semibold">Avoid</p>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.avoid}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="products" class="px-4 py-20 sm:px-6 md:px-12" aria-labelledby="products-title">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Build candidates
          </p>
          <h2
            id="products-title"
            class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            Digital and SaaS candidates
          </h2>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            The best builds are diagnostics and sample outputs that expose a problem, use assets
            already in Maestro or the funnel repos, and create a natural implementation path.
            Deliver them manually before turning the repeated work into software.
          </p>
          <div
            class="mt-10 overflow-x-auto rounded-xl border border-border bg-card shadow-sm"
            data-scroll-region
            tabindex="0"
            role="region"
            aria-label="Digital and SaaS candidate comparison"
          >
            <table class="w-full min-w-[1000px] border-collapse text-left">
              <caption class="sr-only"
                >Ranked adjacent digital and SaaS product opportunities</caption
              >
              <thead class="bg-muted">
                <tr>
                  <th scope="col" class="p-4 font-semibold">Rank</th>
                  <th scope="col" class="p-4 font-semibold">Candidate</th>
                  <th scope="col" class="p-4 font-semibold">Role</th>
                  <th scope="col" class="p-4 font-semibold">Why it fits</th>
                  <th scope="col" class="p-4 font-semibold">First validation</th>
                  <th scope="col" class="p-4 font-semibold">Decision</th>
                </tr>
              </thead>
              <tbody>
                {
                  productCandidates.map((item) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-4 font-mono text-2xl font-bold">{item.rank}</td>
                      <td class="p-4 font-semibold">{item.name}</td>
                      <td class="p-4">{item.type}</td>
                      <td class="p-4 leading-relaxed text-muted-foreground">{item.why}</td>
                      <td class="p-4 leading-relaxed">{item.firstTest}</td>
                      <td class="p-4">
                        <span class="inline-flex rounded-full bg-highlight px-3 py-1 font-semibold text-highlight-foreground">
                          {item.decision}
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="mt-12 rounded-2xl border border-destructive bg-card p-6 sm:p-8">
            <h3 class="text-3xl font-semibold">Do not build these now</h3>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {
                avoidProducts.map(([name, reason]) => (
                  <article class="rounded-xl bg-muted p-5">
                    <h4 class="text-lg font-semibold">{name}</h4>
                    <p class="mt-2 leading-relaxed text-muted-foreground">{reason}</p>
                  </article>
                ))
              }
            </div>
          </div>

          <aside class="mt-10 rounded-2xl border border-brand bg-card p-6 sm:p-8">
            <h3 class="text-2xl font-semibold">The strongest Maestro offer</h3>
            <p class="mt-3 max-w-5xl text-lg leading-relaxed text-muted-foreground">
              Start with <strong class="text-foreground"
                >one call → source-backed claims → one reviewable LinkedIn draft</strong
              >. Then expand the service into a cited company Brain, sales-call signals, funnel
              messaging, and a recurring human-reviewed content operation. Do not advertise native
              LinkedIn publishing, autonomous content operations, public self-serve pricing, or a
              done-for-you Maestro tier until those product and delivery gates are actually ready.
            </p>
          </aside>
        </div>
      </section>

      <section
        id="evidence"
        class="section-muted px-4 py-20 sm:px-6 md:px-12"
        aria-labelledby="evidence-title"
      >
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Competitive funnel library
          </p>
          <h2
            id="evidence-title"
            class="mt-4 max-w-5xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            24 live funnels worth opening
          </h2>
          <p class="mt-5 max-w-4xl text-lg leading-relaxed text-muted-foreground">
            These are the smaller, stranger, or especially relevant examples—not a list of proven
            winners. Each row preserves the exact captured landing page and direct Meta Ad Library
            record. The full 159-row sheet is at <code
              class="rounded bg-background px-2 py-1 font-mono text-sm"
              >/Users/headless/ad-research/meta-ads-live-shortlist.csv</code
            >.
          </p>

          <div
            class="mt-10 overflow-x-auto rounded-xl border border-border bg-card shadow-sm"
            data-scroll-region
            tabindex="0"
            role="region"
            aria-label="Competitive funnel library"
          >
            <table class="w-full min-w-[1080px] border-collapse text-left">
              <caption class="sr-only"
                >Representative active Meta advertisers and their exact funnel links</caption
              >
              <thead class="bg-background">
                <tr>
                  <th scope="col" class="p-4 font-semibold">Advertiser</th>
                  <th scope="col" class="p-4 font-semibold">Funnel</th>
                  <th scope="col" class="p-4 font-semibold">Observed signal</th>
                  <th scope="col" class="p-4 font-semibold">Open</th>
                </tr>
              </thead>
              <tbody>
                {
                  evidence.map((item) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-4">
                        <p class="font-semibold">{item.advertiser}</p>
                        <p class="mt-1 text-sm text-muted-foreground">{item.meta}</p>
                      </td>
                      <td class="p-4">{item.funnel}</td>
                      <td class="p-4 leading-relaxed text-muted-foreground">{item.signal}</td>
                      <td class="p-4">
                        <div class="flex min-w-[11rem] flex-col gap-2">
                          <a href={item.landing} target="_blank" rel="noreferrer" class={linkClass}>
                            Open landing page ↗
                          </a>
                          <a href={item.ad} target="_blank" rel="noreferrer" class={linkClass}>
                            Open Meta ad ↗
                          </a>
                        </div>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="sequence" class="px-4 py-20 sm:px-6 md:px-12" aria-labelledby="sequence-title">
        <div class="mx-auto max-w-7xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
            Execution order
          </p>
          <h2
            id="sequence-title"
            class="mt-4 max-w-4xl text-4xl font-bold tracking-[-0.035em] md:text-5xl"
          >
            The next 30 days
          </h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {
              sequence.map((phase) => (
                <article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
                  <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
                    {phase.window}
                  </p>
                  <h3 class="mt-3 text-2xl font-semibold">{phase.title}</h3>
                  <ul class="mt-5 space-y-3 text-muted-foreground">
                    {phase.actions.map((action) => (
                      <li class="flex gap-3 leading-relaxed">
                        <span
                          class="mt-2 size-2 shrink-0 rounded-full bg-brand"
                          aria-hidden="true"
                        />
                        <span>{action}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>

          <div class="mt-12 rounded-2xl bg-foreground p-8 text-background md:p-12">
            <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand-soft">
              Bottom line
            </p>
            <h3 class="mt-4 max-w-5xl text-3xl font-semibold tracking-tight md:text-5xl">
              Sell the rescue. Prove the system. Let paid delivery tell you what software to build.
            </h3>
            <p class="mt-5 max-w-3xl text-lg leading-relaxed text-brand-soft">
              The first offer should get a stuck product to launch. The second should turn real
              company evidence into a cited growth system through Maestro. Funnel builds and ads
              become expansions after those wedges earn demand.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="#tests"
                class="offer-cta inline-flex min-h-14 items-center rounded-xl bg-brand px-6 py-4 font-bold text-brand-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >Return to the test order ↑</a
              >
              <a
                href="#main-plan"
                class="inline-flex min-h-14 items-center rounded-xl bg-background px-6 py-4 font-bold text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >Back to the recommendation</a
              >
            </div>
          </div>
        </div>
      </section>
    </div>

    <footer class="border-t border-border bg-card px-4 py-10 sm:px-6 md:px-12">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-2 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between"
      >
        <p>
          Prepared from US active Meta ads and current repository product truth on August 4, 2026.
        </p>
        <p>Internal strategy · noindex · links may change after capture.</p>
      </div>
    </footer>
  </div>
</OfferLayout>
