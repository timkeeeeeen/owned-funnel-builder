---
import AuthoritySnapshotPage from '@/components/blueprint/AuthoritySnapshotPage.astro';
import {
  BLUEPRINT_AUDIENCE_SLUGS,
  blueprintAudiences,
  type BlueprintAudienceCopy,
} from '@/data/blueprint-offers';

export const prerender = true;

export function getStaticPaths() {
  return BLUEPRINT_AUDIENCE_SLUGS.map((slug) => ({
    params: { audience: slug },
    props: { audience: blueprintAudiences[slug] },
  }));
}

interface Props {
  audience: BlueprintAudienceCopy;
}

const { audience } = Astro.props;
const description = `${audience.snapshotHeadline} See the exact score, evidence, finding, and draft state this free product must deliver before launch.`;
---

<AuthoritySnapshotPage audience={audience} description={description} />
