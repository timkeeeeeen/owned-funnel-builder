---
import SnapshotThankYouPage from '@/components/blueprint/SnapshotThankYouPage.astro';
import {
  BLUEPRINT_AUDIENCE_SLUGS,
  blueprintAudiences,
  type BlueprintAudienceCopy,
} from '@/data/blueprint-offers';

export const prerender = true;

export function getStaticPaths() {
  return BLUEPRINT_AUDIENCE_SLUGS.map((slug) => ({
    params: { audience: slug },
    props: { audience: blueprintAudiences[slug] },
  }));
}

interface Props {
  audience: BlueprintAudienceCopy;
}

const { audience } = Astro.props;
const description = `Preview the exact bridge from the free Authority Snapshot to the shared $5 CMO Game Plan for ${audience.plural}.`;
---

<SnapshotThankYouPage audience={audience} description={description} />
