---
import OfferLandingPage from '@/components/offers/OfferLandingPage.astro';
import VideoLeadOfferLandingPage from '@/components/offers/templates/VideoLeadOfferLandingPage.astro';
import { offers, publishedOffers, type Offer } from '@/data/offers';
import { resolveOfferTemplate } from '@/data/offerTemplates';

// Keep offer pages content-driven and pre-rendered even when the local editor
// runs Astro in server mode. This also leaves /keystatic to the editor route.
export const prerender = true;

// Each generated route gets its unique description from the offer data object.
export function getStaticPaths() {
  const routableOffers = import.meta.env.DEV ? offers : publishedOffers;

  return routableOffers.map((offer) => ({
    params: { slug: offer.slug },
    props: { offer },
  }));
}

interface Props {
  offer: Offer;
}

const { offer } = Astro.props;
const template = resolveOfferTemplate(offer.template);
const templates = {
  default: OfferLandingPage,
  'video-lead': VideoLeadOfferLandingPage,
};
const LandingPage = templates[template];
---

<LandingPage offer={offer} />
