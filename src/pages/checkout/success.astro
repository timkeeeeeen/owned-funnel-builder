---
import OfferLayout from '@/layouts/OfferLayout.astro';

const title = 'Purchase complete — Maestro Template';
const description = 'Your Maestro Template purchase is complete.';
---

<OfferLayout title={title} description={description} noindex>
  <section class="offer-grid grid min-h-screen place-items-center px-6 py-20 text-center">
    <div class="mx-auto max-w-3xl rounded-xl border border-border bg-card p-8 shadow-lg sm:p-14">
      <span
        class="mx-auto grid size-16 place-items-center rounded-full bg-success text-3xl font-bold text-background"
        aria-hidden="true"
      >
        ✓
      </span>
      <p class="mt-7 font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
        Payment complete
      </p>
      <h1 class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
        You’re in. Check your inbox.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Dodo will send your receipt to the email you used at checkout. Your Maestro Template access
        instructions will follow there too.
      </p>
      <p class="mt-5 text-sm text-muted-foreground">
        Nothing after a few minutes? Email <a
          class="font-semibold text-brand underline"
          href="mailto:tim@keen.digital">tim@keen.digital</a
        > from the address you used to buy.
      </p>
      <a
        href="/vibe-code-anything/"
        class="mt-9 inline-flex min-h-14 items-center justify-center rounded-xl border border-border bg-background px-6 py-4 font-bold shadow-sm hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        Back to Vibe Code Anything
      </a>
    </div>
  </section>
</OfferLayout>
