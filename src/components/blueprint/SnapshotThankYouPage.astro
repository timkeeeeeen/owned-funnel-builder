---
import BlueprintNav from '@/components/blueprint/BlueprintNav.astro';
import BlueprintFunnelRuntime from '@/components/blueprint/BlueprintFunnelRuntime.astro';
import BlueprintScorecard from '@/components/blueprint/BlueprintScorecard.astro';
import DraftPreview from '@/components/blueprint/DraftPreview.astro';
import PreviewNotice from '@/components/blueprint/PreviewNotice.astro';
import { blueprintProductContract, type BlueprintAudienceCopy } from '@/data/blueprint-offers';
import OfferLayout from '@/layouts/OfferLayout.astro';

interface Props {
  audience: BlueprintAudienceCopy;
  description?: string;
}

const { audience, description = `Your private Authority Snapshot for ${audience.plural}.` } =
  Astro.props;
const snapshot = blueprintProductContract.authoritySnapshot;
const plan = blueprintProductContract.gamePlan;
const title = `Your Authority Snapshot | ${audience.switchLabel}`;
---

<OfferLayout title={title} description={description} noindex={true}>
  <div
    data-blueprint-page
    data-page-kind="authority-snapshot-thank-you"
    data-audience={audience.slug}
    data-product-key={blueprintProductContract.sharedProductKey}
    data-preview-status={blueprintProductContract.status}
  >
    <PreviewNotice />
    <BlueprintNav family="authority-snapshot" activeAudience={audience.slug} />

    <main>
      <section class="px-4 py-10 sm:px-6 sm:py-16" aria-labelledby="snapshot-result-title">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-3xl">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">
              Your private result
            </p>
            <h1
              id="snapshot-result-title"
              class="mt-3 text-balance text-4xl font-bold tracking-tight sm:text-6xl"
            >
              Your Authority Snapshot
            </h1>
            <p
              data-blueprint-runtime-status
              role="status"
              aria-live="polite"
              aria-atomic="true"
              class="mt-4 rounded-xl border border-border bg-muted p-4 font-semibold text-muted-foreground"
            >
              We’re reading your public profile now. Your result will appear here automatically.
            </p>
          </div>
          <BlueprintFunnelRuntime audience={audience.slug} mode="thank-you" />

          <section
            data-blueprint-progress
            hidden
            aria-labelledby="snapshot-progress-title"
            class="mt-8 max-w-3xl rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6"
          >
            <h2 id="snapshot-progress-title" class="text-xl font-bold sm:text-2xl">
              Building your Authority Snapshot
            </h2>
            <ol class="mt-6 grid gap-3">
              <li
                data-blueprint-progress-step="accepted"
                data-state="current"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >●</span
                >
                <span>Request accepted</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Latest update</span
                >
              </li>
              <li
                data-blueprint-progress-step="research_started"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Researching your public profile</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
              <li
                data-blueprint-progress-step="sources_discovered"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Finding public sources</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
              <li
                data-blueprint-progress-step="evidence_organized"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Organizing evidence</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
              <li
                data-blueprint-progress-step="dimensions_evaluated"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Evaluating authority dimensions</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
              <li
                data-blueprint-progress-step="post_drafting"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Drafting your starter post</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
              <li
                data-blueprint-progress-step="result_finalized"
                data-state="pending"
                class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-1 rounded-xl bg-muted px-4 py-3 text-sm transition-opacity duration-200 data-[state=pending]:opacity-55 motion-reduce:transition-none sm:grid-cols-[auto_minmax(0,1fr)_auto]"
              >
                <span data-blueprint-progress-marker aria-hidden="true" class="font-bold text-brand"
                  >○</span
                >
                <span>Finalizing your Snapshot</span>
                <span
                  data-blueprint-progress-state
                  class="col-start-2 text-xs font-semibold sm:col-start-auto">Waiting</span
                >
              </li>
            </ol>
            <p
              data-blueprint-progress-source
              hidden
              class="mt-4 rounded-xl border border-border px-4 py-3 text-sm font-semibold"
            >
              <span data-blueprint-progress-source-summary></span>
            </p>
            <div class="mt-4 grid gap-1 text-sm text-muted-foreground sm:grid-cols-2 sm:gap-4">
              <p data-blueprint-progress-elapsed>Elapsed: less than a minute</p>
              <p class="sm:text-end">Your session is saved. You can safely reload this page.</p>
            </div>
          </section>
          <a
            data-blueprint-restart-link
            hidden
            href={`/authority-snapshot/${audience.slug}`}
            class="mt-6 inline-flex min-h-11 items-center font-bold text-brand underline decoration-2 underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Start a new Authority Snapshot
          </a>

          <div
            data-blueprint-result-content
            hidden
            class="mt-8 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start"
          >
            <div>
              <BlueprintScorecard audience={audience} kind="snapshot" showEvidence={true} />
              <article class="mt-5 rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6">
                <p class="text-sm font-bold text-brand" data-blueprint-findings-label>
                  The clearest gaps
                </p>
                <ol class="mt-4 space-y-3" data-blueprint-findings>
                  {
                    audience.exampleEvidence
                      .slice(0, snapshot.maximumFindings)
                      .map((finding) => (
                        <li class="rounded-xl bg-muted p-4 text-sm leading-relaxed">{finding}</li>
                      ))
                  }
                </ol>
              </article>
            </div>
            <div>
              <DraftPreview audience={audience} compact={true} />
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                This starter uses what is public. Any missing client story or proof stays visible
                instead of being invented.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section
        data-blueprint-result-content
        hidden
        class="border-y border-border bg-foreground px-4 py-14 text-background sm:px-6"
        aria-labelledby="next-step-title"
      >
        <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[1fr_0.75fr] lg:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-soft">
              Your next 30 days · $5
            </p>
            <h2 id="next-step-title" class="mt-3 text-balance text-3xl font-bold sm:text-5xl">
              Your Snapshot found the gap. Now decide what to publish.
            </h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-background/70">
              Turn this result into three priorities, a four-week content plan, and your first five
              drafts.
            </p>
            <ul class="mt-6 grid gap-2 text-sm font-semibold sm:grid-cols-3">
              <li>3 priorities</li><li>20 post ideas</li><li>5 starter drafts</li>
            </ul>
          </div>
          <div class="rounded-2xl bg-background p-5 text-foreground sm:p-6">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="text-sm font-bold">$5 CMO Game Plan</p><p
                  class="mt-1 text-sm text-muted-foreground"
                >
                  One payment
                </p>
              </div>
              <p class="text-5xl font-bold">$5</p>
            </div>
            <button
              type="button"
              disabled
              data-blueprint-thank-you-checkout
              data-acceptance-cta="thank-you-checkout"
              class="mt-5 inline-flex min-h-16 w-full cursor-not-allowed items-center justify-center rounded-xl bg-brand px-6 py-4 text-lg font-bold text-brand-foreground opacity-60"
            >
              {plan.ctaLabel}
            </button>
            <p class="mt-3 text-center text-xs leading-relaxed text-muted-foreground">
              {plan.auditExpectation}
            </p>
            <details class="mt-4 text-sm text-muted-foreground">
              <summary class="cursor-pointer py-2 font-semibold text-foreground"
                >Delivery and refund details</summary
              >
              <div class="mt-2 space-y-3 leading-relaxed">
                <p>{blueprintProductContract.commercialTerms.delivery}</p><p>
                  {blueprintProductContract.commercialTerms.refund}
                </p>
              </div>
            </details>
          </div>
        </div>
      </section>
    </main>

    <footer class="px-4 py-8 text-sm text-muted-foreground sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
        <p>
          Need help? <a
            href={`mailto:${blueprintProductContract.supportEmail}`}
            class="font-semibold underline">{blueprintProductContract.supportEmail}</a
          >
        </p>
        <div class="flex gap-4">
          <a href="/privacy/" class="underline">Privacy</a><a href="/terms/" class="underline"
            >Terms</a
          >
        </div>
      </div>
    </footer>
  </div>
</OfferLayout>
