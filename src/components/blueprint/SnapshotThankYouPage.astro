---
import BlueprintNav from '@/components/blueprint/BlueprintNav.astro';
import BlueprintFunnelRuntime from '@/components/blueprint/BlueprintFunnelRuntime.astro';
import BlueprintScorecard from '@/components/blueprint/BlueprintScorecard.astro';
import DraftPreview from '@/components/blueprint/DraftPreview.astro';
import PreviewNotice from '@/components/blueprint/PreviewNotice.astro';
import { blueprintProductContract, type BlueprintAudienceCopy } from '@/data/blueprint-offers';
import OfferLayout from '@/layouts/OfferLayout.astro';

interface Props {
  audience: BlueprintAudienceCopy;
  description?: string;
}

const {
  audience,
  description = `Preview the exact bridge from the free Authority Snapshot to the shared $5 CMO Game Plan for ${audience.plural}.`,
} = Astro.props;
const snapshot = blueprintProductContract.authoritySnapshot;
const plan = blueprintProductContract.gamePlan;
const title = `Your Authority Snapshot | ${audience.switchLabel}`;
---

<OfferLayout title={title} description={description} noindex={true}>
  <div
    data-blueprint-page
    data-page-kind="authority-snapshot-thank-you"
    data-audience={audience.slug}
    data-product-key={blueprintProductContract.sharedProductKey}
    data-preview-status={blueprintProductContract.status}
  >
    <PreviewNotice />
    <BlueprintNav family="authority-snapshot" activeAudience={audience.slug} />

    <section
      class="offer-grid border-b border-border px-4 py-12 sm:px-6 sm:py-20"
      aria-labelledby="thank-you-title"
    >
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
        <div>
          <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
            After your free Snapshot
          </p>
          <h1
            id="thank-you-title"
            class="mt-4 text-balance text-5xl font-bold leading-[0.96] tracking-[-0.045em] sm:text-6xl lg:text-7xl"
          >
            Your Snapshot is the diagnosis. It cannot choose the month for you.
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground sm:text-xl">
            This is where you will see that your saved Snapshot is underway and choose what happens
            next: keep the public diagnosis, or add the private context that turns it into a ranked
            30-day plan for $5.
          </p>
          <div
            class="mt-7 flex items-center gap-4 rounded-xl border-2 border-brand bg-card p-4 shadow-sm"
          >
            <div class="min-w-0 flex-1">
              <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">
                $5 CMO Game Plan
              </p>
              <p class="mt-1 font-semibold">Three priorities · 20 slots · five retained drafts</p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {plan.snapshotBridgeContinuity}
              </p>
            </div>
            <span class="text-4xl font-bold">$5</span>
          </div>
          <button
            type="button"
            disabled
            data-blueprint-thank-you-checkout
            data-acceptance-cta="thank-you-hero-checkout"
            class="mt-3 inline-flex min-h-16 w-full cursor-not-allowed items-center justify-center rounded-xl bg-brand px-5 py-4 text-center text-lg font-bold text-brand-foreground opacity-60"
          >
            {plan.ctaLabel}
          </button>
          <p class="mt-3 text-center text-sm font-semibold text-muted-foreground">
            {plan.auditExpectation}
          </p>
          <BlueprintFunnelRuntime audience={audience.slug} mode="thank-you" />
          <div
            class="mt-5 rounded-xl border border-highlight-foreground/25 bg-highlight p-5 text-highlight-foreground"
          >
            <p class="font-bold">This is a design preview</p>
            <p
              data-blueprint-runtime-status
              aria-live="polite"
              class="mt-2 text-sm leading-relaxed"
            >
              No Snapshot was submitted in this page view, and no email was sent. The live page will
              appear only after a real request has been accepted and saved securely.
            </p>
          </div>
        </div>

        <div>
          <BlueprintScorecard audience={audience} kind="snapshot" showEvidence={true} />
          <article class="mt-5 rounded-xl border border-border bg-card p-5 shadow-sm">
            <p
              class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand"
              data-blueprint-findings-label
            >
              Synthetic findings
            </p>
            <ol class="mt-4 space-y-3" data-blueprint-findings>
              {
                audience.exampleEvidence
                  .slice(0, snapshot.maximumFindings)
                  .map((finding) => (
                    <li class="rounded-xl bg-muted p-4 text-sm leading-relaxed">{finding}</li>
                  ))
              }
            </ol>
          </article>
        </div>
      </div>
    </section>

    <section class="px-4 py-20 sm:px-6" aria-labelledby="saved-draft-title">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
            Your saved starter
          </p>
          <h2
            id="saved-draft-title"
            class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl"
          >
            One useful draft, with missing source material left visible.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            The Snapshot does not invent private proof. It keeps the exact questions needed to
            strengthen the draft, and the paid plan retains this work as Post 1.
          </p>
        </div>
        <DraftPreview audience={audience} compact={true} />
      </div>
    </section>

    <section class="px-4 py-20 sm:px-6" aria-labelledby="gap-title">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-4xl text-center">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
            The honest limitation
          </p>
          <h2
            id="gap-title"
            class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl"
          >
            A <span data-blueprint-score-copy>25/40</span> public score can expose what buyers see. It
            cannot become a /100 system score.
          </h2>
          <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
            The paid audit uses a different instrument. It preserves the Visible Authority Score
            beside the new result for context; it never adds the two scores together.
          </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <article class="rounded-xl border border-border bg-muted p-6 sm:p-8">
            <p
              class="font-mono text-sm font-bold uppercase tracking-[0.14em] text-muted-foreground"
            >
              What the free result knows
            </p>
            <h3 class="mt-3 text-3xl font-semibold">The public evidence</h3>
            <ul class="mt-6 space-y-4 leading-relaxed">
              <li>✓ What the LinkedIn profile makes visible</li>
              <li>✓ What recent public content repeatedly teaches</li>
              <li>✓ Up to {snapshot.maximumFindings} findings tied to those sources</li>
              <li>✓ One strong starter that does not invent private proof</li>
            </ul>
          </article>

          <article class="rounded-xl border-2 border-brand bg-card p-6 shadow-sm sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="font-mono text-sm font-bold uppercase tracking-[0.14em] text-brand">
                  What the $5 intake adds
                </p>
                <h3 class="mt-3 text-3xl font-semibold">The operating context</h3>
              </div>
              <span class="text-5xl font-bold">$5</span>
            </div>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
              <li class="rounded-xl bg-muted p-4 font-semibold">Offer and best-fit buyer</li>
              <li class="rounded-xl bg-muted p-4 font-semibold">Permitted proof and stories</li>
              <li class="rounded-xl bg-muted p-4 font-semibold">Inbound and outbound reality</li>
              <li class="rounded-xl bg-muted p-4 font-semibold">30-day commercial objective</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      class="border-y border-border bg-foreground px-4 py-20 text-background sm:px-6"
      aria-labelledby="bridge-offer-title"
    >
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand-soft">
            One natural next step
          </p>
          <h2
            id="bridge-offer-title"
            class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl"
          >
            Turn the gap into three priorities, 20 slots, and five drafts.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-background/75">
            Whether you arrive here after a free Snapshot or from the direct $5 page, the same saved
            result becomes the foundation for your CMO Game Plan.
          </p>
          <ol class="mt-8 space-y-4">
            <li class="flex gap-4">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-background font-mono font-bold text-foreground"
                >1</span
              ><span class="pt-2 font-semibold">Complete the missing private context.</span>
            </li>
            <li class="flex gap-4">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-background font-mono font-bold text-foreground"
                >2</span
              ><span class="pt-2 font-semibold"
                >Challenge the evidence and accept the three ranked moves.</span
              >
            </li>
            <li class="flex gap-4">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-background font-mono font-bold text-foreground"
                >3</span
              ><span class="pt-2 font-semibold"
                >Keep your Snapshot as Post 1, plus four new drafts, without activating anything
                else.</span
              >
            </li>
          </ol>
        </div>

        <article
          class="rounded-xl border border-background/25 bg-background p-6 text-foreground shadow-sm sm:p-8"
        >
          <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border pb-6">
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">
                $5 CMO Game Plan
              </p>
              <h3 class="mt-2 text-3xl font-semibold">Prescription after diagnosis</h3>
            </div>
            <p class="text-6xl font-bold">$5</p>
          </div>
          <ul class="mt-6 space-y-3 leading-relaxed">
            <li>✓ Separate Authority System Score across 20 named criteria</li>
            <li>✓ Three ranked priorities tied to evidence</li>
            <li>✓ Four-week, 20-slot content board</li>
            <li>✓ First five drafts with visible readiness states</li>
            <li>✓ Persistent ownership without Blueprint Activation</li>
          </ul>
          <a
            href={`/cmo-game-plan/${audience.slug}/`}
            data-preserve-attribution
            class="mt-7 inline-flex min-h-14 w-full items-center justify-center rounded-xl border border-foreground bg-foreground px-5 py-4 text-center font-bold text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            Inspect the complete product example →
          </a>
          <button
            type="button"
            disabled
            data-acceptance-cta="thank-you-checkout"
            class="mt-3 inline-flex min-h-20 w-full cursor-not-allowed items-center justify-center rounded-xl bg-brand px-6 py-5 text-center text-xl font-bold text-brand-foreground opacity-60"
          >
            {plan.ctaLabel}
          </button>
          <p class="mt-4 text-center text-sm leading-relaxed text-muted-foreground">
            {plan.auditExpectation}
          </p>
          <p class="mt-2 text-center text-sm leading-relaxed text-muted-foreground">
            {plan.ctaNote}
          </p>
          <details class="mt-5 rounded-xl border border-border bg-muted p-4 text-left">
            <summary class="min-h-11 cursor-pointer py-2 font-bold">
              Delivery, included revision, and refund
            </summary>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-muted-foreground">
              <p>{blueprintProductContract.commercialTerms.delivery}</p>
              <p>{blueprintProductContract.commercialTerms.includedRevision}</p>
              <p>{blueprintProductContract.commercialTerms.refund}</p>
            </div>
          </details>
        </article>
      </div>
    </section>

    <footer class="px-4 py-10 sm:px-6">
      <div
        class="mx-auto flex max-w-7xl flex-col gap-3 border-t border-border pt-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
      >
        <p>Private product preview · no submission or purchase occurred</p>
        <div class="flex flex-wrap items-center gap-4">
          <a class="min-h-11 py-3 font-semibold underline" href="/privacy/">Privacy</a>
          <a class="min-h-11 py-3 font-semibold underline" href="/terms/">Terms</a>
          <a
            class="min-h-11 py-3 font-semibold underline"
            href={`mailto:${blueprintProductContract.supportEmail}`}
          >
            {blueprintProductContract.supportEmail}
          </a>
        </div>
      </div>
    </footer>
  </div>
</OfferLayout>
