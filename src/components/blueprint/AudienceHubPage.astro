---
import BlueprintNav from '@/components/blueprint/BlueprintNav.astro';
import PreviewNotice from '@/components/blueprint/PreviewNotice.astro';
import {
  BLUEPRINT_AUDIENCE_SLUGS,
  blueprintAudiences,
  blueprintProductContract,
} from '@/data/blueprint-offers';
import OfferLayout from '@/layouts/OfferLayout.astro';

interface Props {
  family: 'authority-snapshot' | 'cmo-game-plan';
  description?: string;
}

const { family, description: suppliedDescription } = Astro.props;
const isSnapshot = family === 'authority-snapshot';
const offerLabel = isSnapshot ? 'free Authority Snapshot' : '$5 CMO Game Plan';
const title = `${isSnapshot ? 'Authority Snapshot' : '$5 CMO Game Plan'} Audience Previews`;
const description =
  suppliedDescription ??
  `Choose a message-matched ${offerLabel} acceptance preview for agency owners, consultants, coaches, or solo experts.`;
---

<OfferLayout title={title} description={description} noindex={true}>
  <div
    data-blueprint-page
    data-page-kind={`${family}-audience-hub`}
    data-preview-status={blueprintProductContract.status}
  >
    <PreviewNotice />
    <BlueprintNav family={family} />

    <section
      class="offer-grid min-h-[75vh] px-4 py-16 sm:px-6 sm:py-20"
      aria-labelledby="audience-hub-title"
    >
      <div class="mx-auto max-w-7xl">
        <div class="max-w-5xl">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
            Message-match review
          </p>
          <h1
            id="audience-hub-title"
            class="mt-4 text-balance text-5xl font-bold leading-[0.96] tracking-[-0.045em] sm:text-7xl"
          >
            One {offerLabel}. Four buyer-specific ways into it.
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
            Choose the business model closest to yours. Headlines, examples, and objections change;
            the underlying product promise and fulfillment contract stay identical.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {
            BLUEPRINT_AUDIENCE_SLUGS.map((slug) => {
              const audience = blueprintAudiences[slug];
              const headline = isSnapshot ? audience.snapshotHeadline : audience.gamePlanHeadline;
              const subheadline = isSnapshot
                ? audience.snapshotSubheadline
                : audience.gamePlanSubheadline;
              return (
                <article class="flex flex-col rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
                  <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">
                    {audience.switchLabel}
                  </p>
                  <h2 class="mt-3 text-3xl font-semibold tracking-tight">{headline}</h2>
                  <p class="mt-4 flex-1 leading-relaxed text-muted-foreground">{subheadline}</p>
                  <a
                    href={`/${family}/${slug}/`}
                    data-preserve-attribution
                    class="mt-7 inline-flex min-h-14 items-center justify-center rounded-xl bg-foreground px-5 py-4 text-center font-bold text-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  >
                    Review the {audience.singular} version →
                  </a>
                </article>
              );
            })
          }
        </div>

        <p
          class="mt-8 rounded-xl border border-highlight-foreground/25 bg-highlight p-5 text-sm font-semibold leading-relaxed text-highlight-foreground"
        >
          These are acceptance previews, not live offers. No audience route can submit a Snapshot or
          start checkout.
        </p>
      </div>
    </section>
  </div>
</OfferLayout>
