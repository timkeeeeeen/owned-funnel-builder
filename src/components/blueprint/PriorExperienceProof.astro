---
import { blueprintProductContract } from '@/data/blueprint-offers';
---

<section class="px-4 py-20 sm:px-6" aria-labelledby="prior-proof-title">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-brand">
        Earlier clients and programs
      </p>
      <h2 id="prior-proof-title" class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">
        The thinking comes from real agency work. These products are still new.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
        Before building the Authority Snapshot and CMO Game Plan, Tim used LinkedIn to grow and sell
        his own agency, then helped other agency owners improve their offers and pipeline. The
        quotes below come from that earlier work. They are not results from these new products.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        blueprintProductContract.testimonials.map((testimonial) => (
          <figure class="rounded-xl border border-border bg-muted p-6">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
              Earlier program participant
            </p>
            <blockquote class="mt-4 text-lg font-semibold leading-relaxed">
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-5 text-sm">
              <>
                <span class="font-bold">{testimonial.author}</span>
                <br />
              </>
              <span class="text-muted-foreground">{testimonial.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p
      class="mt-6 rounded-xl border border-highlight-foreground/25 bg-highlight p-5 text-sm font-semibold leading-relaxed text-highlight-foreground"
    >
      {blueprintProductContract.proofDisclaimer}
    </p>
  </div>
</section>
