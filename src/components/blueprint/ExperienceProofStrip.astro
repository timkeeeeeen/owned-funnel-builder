---
import { blueprintProductContract } from '@/data/blueprint-offers';
---

<section
  class="border-y border-border bg-muted px-4 py-7 sm:px-6"
  aria-label="Tim's relevant experience"
>
  <div class="mx-auto max-w-6xl">
    <dl class="grid grid-cols-2 gap-x-5 gap-y-6 text-center lg:grid-cols-4">
      {
        blueprintProductContract.proof.map((item) => (
          <div>
            <dt class="text-2xl font-bold tracking-tight sm:text-3xl">{item.value}</dt>
            <dd class="mt-1 text-xs font-bold uppercase tracking-[0.1em] text-muted-foreground">
              {item.label}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-5 text-center text-xs leading-relaxed text-muted-foreground">
      Tim’s earlier agency and coaching experience—not claimed as results from this new product.
    </p>
  </div>
</section>
