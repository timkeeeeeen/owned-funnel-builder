---
import BlueprintFunnelRuntime from '@/components/blueprint/BlueprintFunnelRuntime.astro';
import ExperienceProofStrip from '@/components/blueprint/ExperienceProofStrip.astro';
import PreviewNotice from '@/components/blueprint/PreviewNotice.astro';
import { blueprintProductContract, type BlueprintAudienceCopy } from '@/data/blueprint-offers';
import OfferLayout from '@/layouts/OfferLayout.astro';

interface Props {
  audience: BlueprintAudienceCopy;
  description?: string;
}

const { audience, description = audience.gamePlanSubheadline } = Astro.props;
const plan = blueprintProductContract.gamePlan;
const title = `$5 CMO Game Plan for ${audience.switchLabel}`;
---

<OfferLayout title={title} description={description} noindex={true}>
  <div
    data-blueprint-page
    data-page-kind="cmo-game-plan"
    data-audience={audience.slug}
    data-product-key={blueprintProductContract.sharedProductKey}
    data-preview-status={blueprintProductContract.status}
  >
    <PreviewNotice />
    <ExperienceProofStrip />

    <main class="min-h-screen bg-background px-4 py-10 sm:px-6 sm:py-16">
      <section
        class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1fr_0.82fr] lg:items-center"
        aria-labelledby="game-plan-title"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">
            $5 · one-time · for {audience.plural}
          </p>
          <h1
            id="game-plan-title"
            class="mt-4 max-w-3xl text-balance text-4xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl"
          >
            {audience.gamePlanHeadline}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
            {audience.gamePlanSubheadline}
          </p>
          <p class="mt-6 max-w-xl text-sm leading-relaxed text-muted-foreground">
            A personalized 30-day publishing plan you can keep. No subscription, and nothing is
            posted for you.
          </p>
        </div>

        <form
          id="game-plan-start"
          data-blueprint-start-form
          class="rounded-2xl border border-border bg-card p-5 shadow-xl sm:p-7"
          aria-describedby="game-plan-form-status"
        >
          <p class="text-xl font-bold">Build your next 30 days.</p>
          <div class="mt-5 grid gap-4">
            <label class="block text-sm font-bold" for={`game-plan-linkedin-${audience.slug}`}>
              LinkedIn profile
              <input
                id={`game-plan-linkedin-${audience.slug}`}
                name="linkedin"
                data-blueprint-input
                type="url"
                inputmode="url"
                autocomplete="url"
                placeholder="linkedin.com/in/you"
                disabled
                required
                class="mt-2 min-h-14 w-full rounded-xl border-2 border-border bg-background px-4 text-base disabled:cursor-not-allowed disabled:bg-muted"
              />
            </label>
            <label class="block text-sm font-bold" for={`game-plan-email-${audience.slug}`}>
              Email for your plan
              <input
                id={`game-plan-email-${audience.slug}`}
                name="email"
                data-blueprint-input
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="you@company.com"
                disabled
                required
                class="mt-2 min-h-14 w-full rounded-xl border-2 border-border bg-background px-4 text-base disabled:cursor-not-allowed disabled:bg-muted"
              />
            </label>
          </div>
          <BlueprintFunnelRuntime audience={audience.slug} mode="direct" />
          <button
            type="submit"
            disabled
            data-blueprint-primary-action
            data-acceptance-cta="game-plan-checkout"
            class="mt-4 inline-flex min-h-16 w-full cursor-not-allowed items-center justify-center rounded-xl bg-brand px-6 py-4 text-center text-lg font-bold text-brand-foreground opacity-60"
          >
            {plan.ctaLabel}
          </button>
          <p
            id="game-plan-form-status"
            data-blueprint-runtime-status
            aria-live="polite"
            class="mt-3 text-center text-sm font-semibold text-muted-foreground"
          >
            Add your profile and email to continue to secure checkout.
          </p>
        </form>
      </section>
    </main>
  </div>
</OfferLayout>
