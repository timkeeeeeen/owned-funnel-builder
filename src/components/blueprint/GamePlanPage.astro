---
import BlueprintNav from '@/components/blueprint/BlueprintNav.astro';
import BlueprintFunnelRuntime from '@/components/blueprint/BlueprintFunnelRuntime.astro';
import ExperienceProofStrip from '@/components/blueprint/ExperienceProofStrip.astro';
import PreviewNotice from '@/components/blueprint/PreviewNotice.astro';
import { blueprintProductContract, type BlueprintAudienceCopy } from '@/data/blueprint-offers';
import OfferLayout from '@/layouts/OfferLayout.astro';

interface Props {
  audience: BlueprintAudienceCopy;
  description?: string;
}

const { audience, description = audience.gamePlanSubheadline } = Astro.props;
const plan = blueprintProductContract.gamePlan;
const title = `$5 CMO Game Plan for ${audience.switchLabel}`;
const sampleWeeks = audience.exampleSlots.filter((_, index) => index % 5 === 0).slice(0, 4);
---

<OfferLayout title={title} description={description} noindex={true}>
  <div
    data-blueprint-page
    data-page-kind="cmo-game-plan"
    data-audience={audience.slug}
    data-product-key={blueprintProductContract.sharedProductKey}
    data-preview-status={blueprintProductContract.status}
  >
    <PreviewNotice />
    <BlueprintNav family="cmo-game-plan" activeAudience={audience.slug} />

    <main>
      <section class="px-4 py-12 sm:px-6 sm:py-20" aria-labelledby="game-plan-title">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_0.82fr] lg:items-center">
          <div>
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-brand px-3 py-1 text-sm font-bold text-brand-foreground"
                >$5</span
              >
              <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">
                One-time payment
              </p>
            </div>
            <h1
              id="game-plan-title"
              class="mt-5 max-w-4xl text-balance text-4xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl"
            >
              {audience.gamePlanHeadline}
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
              {audience.gamePlanSubheadline}
            </p>
            <ul
              class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-muted-foreground"
            >
              <li>What to say</li>
              <li>What to publish</li>
              <li>What to do next</li>
            </ul>

            <form
              id="game-plan-start"
              data-blueprint-start-form
              class="mt-8 max-w-2xl rounded-2xl border border-border bg-card p-5 shadow-sm sm:p-6"
              aria-describedby="game-plan-form-status"
            >
              <p class="font-bold">Start with the profile your buyers already see.</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-bold" for={`game-plan-linkedin-${audience.slug}`}>
                  LinkedIn profile
                  <input
                    id={`game-plan-linkedin-${audience.slug}`}
                    name="linkedin"
                    data-blueprint-input
                    type="url"
                    inputmode="url"
                    autocomplete="url"
                    placeholder="linkedin.com/in/you"
                    disabled
                    required
                    class="mt-2 min-h-14 w-full rounded-xl border-2 border-border bg-background px-4 text-base disabled:cursor-not-allowed disabled:bg-muted"
                  />
                </label>
                <label class="block text-sm font-bold" for={`game-plan-email-${audience.slug}`}>
                  Email for your plan
                  <input
                    id={`game-plan-email-${audience.slug}`}
                    name="email"
                    data-blueprint-input
                    type="email"
                    inputmode="email"
                    autocomplete="email"
                    placeholder="you@company.com"
                    disabled
                    required
                    class="mt-2 min-h-14 w-full rounded-xl border-2 border-border bg-background px-4 text-base disabled:cursor-not-allowed disabled:bg-muted"
                  />
                </label>
              </div>
              <BlueprintFunnelRuntime audience={audience.slug} mode="direct" />
              <button
                type="submit"
                disabled
                data-blueprint-primary-action
                data-acceptance-cta="game-plan-checkout"
                class="mt-4 inline-flex min-h-16 w-full cursor-not-allowed items-center justify-center rounded-xl bg-brand px-6 py-4 text-center text-lg font-bold text-brand-foreground opacity-60"
              >
                {plan.ctaLabel}
              </button>
              <p class="mt-3 text-center text-sm text-muted-foreground">
                Secure checkout next · no subscription · nothing is auto-published
              </p>
              <p
                id="game-plan-form-status"
                data-blueprint-runtime-status
                aria-live="polite"
                class="mt-3 text-center text-sm font-semibold text-muted-foreground"
              >
                Add your profile and email to personalize the plan before checkout.
              </p>
            </form>
          </div>

          <aside class="overflow-hidden rounded-2xl border border-border bg-card shadow-xl">
            <div class="bg-foreground p-6 text-background sm:p-8">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-soft">
                Your 30-day plan
              </p>
              <h2 class="mt-3 text-3xl font-bold">Four weeks. One commercial goal.</h2>
              <p class="mt-3 text-background/65">
                Example for a {audience.singular}. Your plan uses your offer, proof, and objective.
              </p>
            </div>
            <ol class="divide-y divide-border">
              {
                sampleWeeks.map((title, index) => (
                  <li class="grid grid-cols-[auto_1fr] gap-4 p-5 sm:p-6">
                    <span class="grid size-10 place-items-center rounded-full bg-muted text-sm font-bold">
                      {index + 1}
                    </span>
                    <div>
                      <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
                        Week {index + 1}
                      </p>
                      <p class="mt-1 font-semibold leading-snug">{title}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </aside>
        </div>
      </section>

      <ExperienceProofStrip />

      <section
        class="border-b border-border bg-muted px-4 py-16 sm:px-6"
        aria-labelledby="plan-output-title"
      >
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">The outcome</p>
            <h2
              id="plan-output-title"
              class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl"
            >
              Stop deciding what to post every morning.
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
              Leave with a focused month tied to the buyer and offer you want to grow now.
            </p>
          </div>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <article class="rounded-2xl border border-border bg-card p-6">
              <p class="text-sm font-bold text-brand">01 · Direction</p>
              <h3 class="mt-3 text-xl font-bold">Three priorities</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">
                The few moves that matter most for your next 30 days.
              </p>
            </article>
            <article class="rounded-2xl border border-border bg-card p-6">
              <p class="text-sm font-bold text-brand">02 · Calendar</p>
              <h3 class="mt-3 text-xl font-bold">Twenty post ideas</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">
                A complete four-week plan shaped around your buyer and proof.
              </p>
            </article>
            <article class="rounded-2xl border border-border bg-card p-6">
              <p class="text-sm font-bold text-brand">03 · Momentum</p>
              <h3 class="mt-3 text-xl font-bold">Your first five drafts</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">
                Strong starting copy, with any missing stories clearly marked.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="px-4 py-16 sm:px-6" aria-labelledby="plan-proof-title">
        <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-center">
          <div>
            <p class="text-5xl font-bold tracking-tight">$300K/mo</p>
            <p class="mt-2 font-semibold">Tim’s agency before its seven-figure sale</p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Its growth was LinkedIn-led. That operating experience informs the plan; it does not
              guarantee the same result.
            </p>
          </div>
          <figure class="rounded-2xl border border-border bg-card p-6 sm:p-8">
            <blockquote class="text-xl font-semibold leading-relaxed">
              “{blueprintProductContract.testimonials[1].quote}”
            </blockquote>
            <figcaption class="mt-4 text-sm text-muted-foreground">
              {blueprintProductContract.testimonials[1].author} · {
                blueprintProductContract.testimonials[1].role
              }
            </figcaption>
            <p class="mt-4 text-xs leading-relaxed text-muted-foreground">
              Earlier coaching result. It is not a result from this new Game Plan.
            </p>
          </figure>
        </div>
      </section>

      <section class="bg-foreground px-4 py-16 text-background sm:px-6">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-soft">
            One payment · $5
          </p>
          <h2 class="mt-3 text-balance text-3xl font-bold sm:text-5xl">
            Get the month out of your head and onto the page.
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-background/70">
            About 10 minutes of input. A focused 30-day plan you can keep.
          </p>
          <a
            href="#game-plan-start"
            class="mt-7 inline-flex min-h-16 w-full items-center justify-center rounded-xl bg-brand px-6 py-4 text-lg font-bold text-brand-foreground sm:w-auto sm:min-w-80"
          >
            {plan.ctaLabel}
          </a>
          <details class="mx-auto mt-6 max-w-2xl text-left text-sm text-background/65">
            <summary class="cursor-pointer py-2 font-semibold text-background"
              >Delivery and refund details</summary
            >
            <div class="mt-2 space-y-3 leading-relaxed">
              <p>{blueprintProductContract.commercialTerms.delivery}</p><p>
                {blueprintProductContract.commercialTerms.refund}
              </p>
            </div>
          </details>
        </div>
      </section>
    </main>

    <footer class="px-4 py-8 text-sm text-muted-foreground sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
        <p>© Modern Agency Sales</p>
        <div class="flex gap-4">
          <a href="/privacy/" class="underline">Privacy</a><a href="/terms/" class="underline"
            >Terms</a
          >
        </div>
      </div>
    </footer>
  </div>
</OfferLayout>
