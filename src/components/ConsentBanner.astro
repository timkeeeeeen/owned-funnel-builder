<aside
  data-consent-banner
  hidden
  class="fixed inset-x-4 bottom-4 z-[120] mx-auto max-w-3xl rounded-2xl border border-border bg-background p-5 text-foreground shadow-2xl sm:inset-x-auto sm:right-6 sm:p-7"
  aria-labelledby="consent-title"
  aria-describedby="consent-description"
>
  <div data-consent-dialog role="dialog" aria-modal="true" aria-label="Privacy choices">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-brand">
      Privacy choices
    </p>
    <h2 id="consent-title" class="mt-2 text-xl font-bold">Choose how this site measures visits</h2>
    <p id="consent-description" class="mt-2 text-sm leading-relaxed text-muted-foreground">
      Necessary storage keeps checkout working. Analytics and advertising storage are optional and
      can be changed later.
    </p>

    <div
      data-consent-customize-panel
      hidden
      class="mt-5 space-y-3 rounded-xl border border-border bg-muted/40 p-4"
    >
      <label class="flex items-start gap-3 text-sm">
        <input data-consent-analytics type="checkbox" class="mt-0.5 size-5 shrink-0" />
        <span
          ><span class="font-semibold">Analytics</span><span class="block text-muted-foreground"
            >Anonymous page measurement and performance checks.</span
          ></span
        >
      </label>
      <label class="flex items-start gap-3 text-sm">
        <input data-consent-advertising type="checkbox" class="mt-0.5 size-5 shrink-0" />
        <span
          ><span class="font-semibold">Advertising</span><span class="block text-muted-foreground"
            >Meta Pixel and campaign attribution.</span
          ></span
        >
      </label>
    </div>

    <div class="mt-5 flex flex-wrap gap-3" data-consent-actions>
      <button
        type="button"
        data-consent-accept
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-5 py-3 font-bold text-brand-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >Accept all</button
      >
      <button
        type="button"
        data-consent-reject
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-background px-5 py-3 font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >Reject all</button
      >
      <button
        type="button"
        data-consent-customize
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border bg-background px-5 py-3 font-bold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >Customize</button
      >
    </div>
    <button
      type="button"
      data-consent-save
      hidden
      class="mt-3 inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-5 py-3 font-bold text-brand-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >Save preferences</button
    >
  </div>
</aside>

<button
  type="button"
  data-consent-preferences
  hidden
  class="fixed bottom-4 left-4 z-[119] inline-flex min-h-10 items-center rounded-full border border-border bg-background px-4 py-2 text-sm font-bold shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
>
  Privacy preferences
</button>

<script is:inline>
  (() => {
    const banner = document.querySelector('[data-consent-banner]');
    const preferences = document.querySelector('[data-consent-preferences]');
    if (!banner || !preferences) return;
    const policyVersion = '2026-08-04';
    const storageKey = `maestro:consent:${policyVersion}`;
    const gpc = navigator.globalPrivacyControl === true;
    // The server separately enforces Sec-GPC; this browser gate prevents a race.
    const readStored = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || 'null');
        return value && typeof value === 'object' && value.resolved === true ? value : null;
      } catch {
        return null;
      }
    };
    const emit = (state) => {
      window.__maestroConsent = state;
      window.dispatchEvent(new CustomEvent('maestro:consent', { detail: state }));
    };
    const hide = () => {
      banner.hidden = true;
      preferences.hidden = false;
    };
    const show = () => {
      banner.hidden = false;
      preferences.hidden = true;
      banner.querySelector('[data-consent-accept]')?.focus();
    };
    const save = (analytics, advertising, source = 'ui') => {
      const state = {
        resolved: true,
        analytics: Boolean(analytics) && !gpc,
        advertising: Boolean(advertising) && !gpc,
        policyVersion,
        source: gpc ? 'gpc' : source,
        effectiveAt: new Date().toISOString(),
      };
      try {
        localStorage.setItem(storageKey, JSON.stringify(state));
      } catch {
        /* memory state still gates this page */
      }
      emit(state);
      hide();
    };
    const stored = readStored();
    if (gpc) {
      save(false, false, 'gpc');
    } else if (stored) {
      emit(stored);
      hide();
    } else {
      emit({ resolved: false, analytics: false, advertising: false, policyVersion });
      show();
    }
    banner
      .querySelector('[data-consent-accept]')
      ?.addEventListener('click', () => save(true, true));
    banner
      .querySelector('[data-consent-reject]')
      ?.addEventListener('click', () => save(false, false));
    banner.querySelector('[data-consent-customize]')?.addEventListener('click', () => {
      const panel = banner.querySelector('[data-consent-customize-panel]');
      const saveButton = banner.querySelector('[data-consent-save]');
      if (panel) panel.hidden = false;
      if (saveButton) saveButton.hidden = false;
      banner.querySelector('[data-consent-analytics]')?.focus();
    });
    banner.querySelector('[data-consent-save]')?.addEventListener('click', () => {
      save(
        banner.querySelector('[data-consent-analytics]')?.checked,
        banner.querySelector('[data-consent-advertising]')?.checked
      );
    });
    preferences.addEventListener('click', show);
    window.addEventListener('maestro:consent-withdraw', () => save(false, false));
  })();
</script>
