---
import type { OfferAssistantSection } from '@/data/offers';

interface Props {
  section: OfferAssistantSection;
}

const { section } = Astro.props;
---

<section class="bg-foreground px-6 py-20 text-background" aria-labelledby="assistant-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand-soft">
        {section.eyebrow}
      </p>
      <h2
        id="assistant-title"
        class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-background/65 md:text-xl">
        {section.description}
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="rounded-xl border border-background/20 bg-panel-dark p-5 sm:p-7" data-animate>
        <div class="flex items-center justify-between gap-4 border-b border-background/20 pb-4">
          <div>
            <p class="font-semibold">Talk to the repository</p>
            <p class="mt-1 text-sm text-background/55">Claude Code or Codex</p>
          </div>
          <span class="size-2.5 rounded-full bg-success">
            <span class="sr-only">Agent ready</span>
          </span>
        </div>

        <ol class="mt-6 space-y-4">
          {
            section.conversation.map((line) => (
              <li class={`flex ${line.speaker === 'You' ? 'justify-end' : 'justify-start'}`}>
                <div
                  class={`max-w-[92%] rounded-xl border p-4 sm:max-w-[84%] ${
                    line.speaker === 'You'
                      ? 'border-brand/50 bg-brand text-brand-foreground'
                      : 'border-background/20 bg-background/5 text-background'
                  }`}
                >
                  <p
                    class={`font-mono text-xs font-bold uppercase tracking-[0.14em] ${
                      line.speaker === 'You' ? 'text-brand-foreground/70' : 'text-brand-soft'
                    }`}
                  >
                    {line.speaker}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed sm:text-base">{line.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </article>

      <ul class="grid gap-4 sm:grid-cols-2" aria-label="Included coding-agent skills">
        {
          section.skills.map((skill, index) => (
            <li
              class="rounded-xl border border-background/20 bg-background/5 p-5"
              data-animate
              data-delay={String((index % 3) + 1)}
            >
              <p class="font-mono text-xs font-bold text-brand-soft">
                SKILL / {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-3 text-xl font-semibold">{skill.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-background/60">{skill.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
