---
import type { OfferPreviewSection } from '@/data/offers';

interface Props {
  section: OfferPreviewSection;
}

const { section } = Astro.props;
---

<section class="px-6 py-20" aria-labelledby="preview-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
        {section.eyebrow}
      </p>
      <h2
        id="preview-title"
        class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground md:text-xl">
        {section.description}
      </p>
    </div>

    <article
      class="mt-14 overflow-hidden rounded-xl border border-border bg-card shadow-lg"
      aria-label="Simplified preview of the Maestro reference application"
      data-animate="scale"
    >
      <header
        class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-6"
      >
        <div class="flex gap-2" aria-hidden="true">
          <span class="size-3 rounded-full bg-destructive"></span>
          <span class="size-3 rounded-full bg-highlight"></span>
          <span class="size-3 rounded-full bg-success"></span>
        </div>
        <p
          class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
        >
          {section.workspaceLabel}
        </p>
      </header>

      <div class="grid lg:grid-cols-[15rem_1fr]">
        <div class="border-b border-border bg-muted p-5 lg:border-b-0 lg:border-r">
          <p class="text-lg font-bold">{section.productLabel}</p>
          <p class="mt-1 text-sm text-muted-foreground">{section.productDescription}</p>
          <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-1">
            {
              section.navItems.map((item) => (
                <li
                  class={`rounded-xl px-3 py-2 text-sm font-semibold ${
                    item === section.activeNavItem
                      ? 'bg-brand text-brand-foreground'
                      : 'text-muted-foreground'
                  }`}
                >
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="p-5 sm:p-8">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-brand">
                {section.activeEyebrow}
              </p>
              <h3 class="mt-2 text-2xl font-semibold sm:text-3xl">{section.activeTitle}</h3>
              <p class="mt-2 text-muted-foreground">{section.activeDescription}</p>
            </div>
            <span
              class="inline-flex min-h-11 items-center self-start rounded-full border border-success/40 bg-success/10 px-4 py-2 text-sm font-semibold text-success"
            >
              {section.statusLabel}
            </span>
          </div>

          <ol class="mt-8 grid gap-3 sm:grid-cols-4" aria-label="Workflow stages">
            {
              section.stages.map((step, index) => (
                <li class="rounded-xl border border-border bg-background p-4">
                  <p class="font-mono text-xs font-bold text-brand">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <p class="mt-2 font-semibold">{step}</p>
                </li>
              ))
            }
          </ol>

          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {
              section.panels.map((panel) => (
                <div class="rounded-xl border border-border bg-muted p-5">
                  <h4 class="text-lg font-semibold">{panel.title}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    {panel.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
