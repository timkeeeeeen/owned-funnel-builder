---
import type { OfferExamplesSection } from '@/data/offers';

interface Props {
  section: OfferExamplesSection;
}

const { section } = Astro.props;
---

<section class="px-6 py-20" aria-labelledby="examples-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
        {section.eyebrow}
      </p>
      <h2
        id="examples-title"
        class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground md:text-xl">
        {section.description}
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        section.items.map((item, index) => (
          <article
            class="rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8"
            data-animate
            data-delay={String((index % 4) + 1)}
          >
            <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-brand">
              {item.label}
            </p>
            <h3 class="mt-4 text-2xl font-semibold sm:text-3xl">{item.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
