---
import OfferLandingPage from '@/components/offers/OfferLandingPage.astro';
import type { Offer } from '@/data/offers';

interface Props {
  offer: Offer;
}

const { offer } = Astro.props;
const checkoutSlug = offer.checkoutFunnelSlug ?? offer.slug;
---

<OfferLandingPage offer={{ ...offer, slug: checkoutSlug }} />
