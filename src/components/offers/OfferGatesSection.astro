---
import type { OfferGatesSection } from '@/data/offers';

interface Props {
  section: OfferGatesSection;
}

const { section } = Astro.props;
---

<section class="bg-muted px-6 py-20" aria-labelledby="gates-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand">
        {section.eyebrow}
      </p>
      <h2
        id="gates-title"
        class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground md:text-xl">
        {section.description}
      </p>
    </div>

    <ol class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
      {
        section.items.map((gate, index) => (
          <li
            class="rounded-xl border border-border bg-card p-5 shadow-sm"
            data-animate
            data-delay={String((index % 5) + 1)}
          >
            <p class="font-mono text-xs font-bold text-brand">{gate.label}</p>
            <h3 class="mt-4 text-xl font-semibold leading-tight">{gate.question}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{gate.description}</p>
            <div class="mt-5 border-t border-border pt-4">
              <p class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-destructive">
                Stops
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{gate.catches}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div
      class="mt-10 rounded-xl border border-brand bg-brand p-6 text-center text-brand-foreground"
    >
      <p class="text-2xl font-bold sm:text-3xl">The AI proposes. The gates decide.</p>
    </div>
  </div>
</section>
