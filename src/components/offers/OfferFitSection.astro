---
import type { OfferFitSection } from '@/data/offers';

interface Props {
  section: OfferFitSection;
}

const { section } = Astro.props;
---

<section class="bg-foreground px-6 py-20 text-background" aria-labelledby="fit-title">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-brand-soft">
        {section.eyebrow}
      </p>
      <h2
        id="fit-title"
        class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight md:text-6xl"
      >
        {section.title}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-background/65 md:text-xl">
        {section.description}
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      <article
        class="rounded-xl border border-success/50 bg-background p-6 text-foreground shadow-sm sm:p-8"
      >
        <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-success">
          This is for you if
        </p>
        <h3 class="mt-3 text-2xl font-semibold sm:text-3xl">You want leverage, not magic.</h3>
        <ul class="mt-8 space-y-4">
          {
            section.forYou.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
                <span class="font-mono font-bold text-success" aria-hidden="true">
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article
        class="rounded-xl border border-destructive/50 bg-background p-6 text-foreground shadow-sm sm:p-8"
      >
        <p class="font-mono text-sm font-bold uppercase tracking-[0.16em] text-destructive">
          Skip this if
        </p>
        <h3 class="mt-3 text-2xl font-semibold sm:text-3xl">
          You want no-code or zero responsibility.
        </h3>
        <ul class="mt-8 space-y-4">
          {
            section.notForYou.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed text-muted-foreground sm:text-lg">
                <span class="font-mono font-bold text-destructive" aria-hidden="true">
                  ×
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
