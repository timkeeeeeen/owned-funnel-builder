---
interface Props {
  rawSrc: string;
  finishedSrc: string;
  poster: string;
  captionsSrc: string;
}

const { rawSrc, finishedSrc, poster, captionsSrc } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-2" data-video-comparison>
  <article class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
    <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-destructive">
          Before / raw clip
        </p>
        <p class="mt-1 text-sm text-muted-foreground">23.47 seconds · abandoned opening kept</p>
      </div>
      <span class="rounded-full border border-border bg-muted px-3 py-1 font-mono text-xs font-bold">
        RAW
      </span>
    </div>
    <video
      class="aspect-[4/5] w-full bg-foreground object-cover"
      controls
      muted
      playsinline
      preload="metadata"
      poster={poster}
      data-proof-video="raw"
      aria-label="Synthetic raw talking-head demo with an abandoned opening take"
    >
      <source src={rawSrc} type="video/mp4" />
      Your browser does not support the raw demo video.
    </video>
  </article>

  <article class="overflow-hidden rounded-xl border-2 border-brand bg-card shadow-lg">
    <div class="flex items-center justify-between gap-3 border-b border-border px-5 py-4">
      <div>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-brand">
          After / review preview
        </p>
        <p class="mt-1 text-sm text-muted-foreground">17.3 seconds · cut, captions, hook, CTA, QA</p>
      </div>
      <span class="rounded-full bg-brand px-3 py-1 font-mono text-xs font-bold text-brand-foreground">
        READY TO REVIEW
      </span>
    </div>
    <video
      class="aspect-[4/5] w-full bg-foreground object-cover"
      controls
      muted
      playsinline
      preload="metadata"
      poster={poster}
      data-proof-video="finished"
      aria-label="Finished synthetic talking-head ad demo with captions and graphics"
    >
      <source src={finishedSrc} type="video/mp4" />
      <track kind="captions" src={captionsSrc} srclang="en" label="English" default />
      Your browser does not support the finished demo video.
    </video>
  </article>
</div>

<p class="mt-5 text-center text-sm leading-relaxed text-muted-foreground">
  Transparent demo disclosure: the fictional presenter image and system voice are synthetic. This is
  product proof, not a customer testimonial or an ad-performance claim.
</p>

<script>
  document.querySelectorAll<HTMLVideoElement>('[data-proof-video]').forEach((video) => {
    const track = (action: string) => {
      const admaxxer = (
        window as Window & {
          admaxxer?: (eventName: string, metadata?: Record<string, unknown>) => void;
        }
      ).admaxxer;
      admaxxer?.('VideoInteraction', {
        offer_slug: 'talking-head-ad-machine',
        video: video.dataset.proofVideo ?? 'unknown',
        action,
      });
    };
    video.addEventListener('play', () => track('play'));
    video.addEventListener('ended', () => track('complete'));
  });
</script>
