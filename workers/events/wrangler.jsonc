{
  // Secret names only; values are never committed: META_ACCESS_TOKEN, TINYBIRD_APPEND_TOKEN,
  // TRACKING_COOKIE_SIGNING_KEY_CURRENT/PREVIOUS, TRACKING_IDENTITY_HMAC_KEY_CURRENT/PREVIOUS,
  // TRACKING_{PAGES,APP_IDEA,BLUEPRINT}_BRIDGE_KEY_CURRENT/PREVIOUS, and
  // TRACKING_CONTEXT_SIGNING_KEY_CURRENT/PREVIOUS, plus per-source key IDs and
  // the Meta pixel/dataset IDs after read-only provider capability verification.
  "name": "maestro-first-party-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "events-preview.shop.maestrogtm.com", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "TRACKING_DB",
      "database_name": "maestro-tracking-preview",
      "database_id": "6a1e98a6-7d32-4b16-bdce-f7078ecc481d",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "maestro-events-preview" },
      { "binding": "EVENTS_DLQ", "queue": "maestro-events-preview-dlq" },
    ],
    "consumers": [
      {
        "queue": "maestro-events-preview",
        "max_batch_size": 50,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "retry_delay": 15,
        "max_concurrency": 4,
        "dead_letter_queue": "maestro-events-preview-dlq",
      },
      {
        "queue": "maestro-events-preview-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 0,
        "max_concurrency": 1,
      },
    ],
  },
  "vars": {
    "TRACKING_ENVIRONMENT": "preview",
    "TRACKING_HOST": "events-preview.shop.maestrogtm.com",
    "TRACKING_INTERNAL_HOST": "tracking.internal",
    "TRACKING_ALLOWED_ORIGINS": "https://tracking-preview.owned-funnel-builder.pages.dev",
    "TRACKING_COOKIE_DOMAIN": "shop.maestrogtm.com",
    "TRACKING_TENANT_ID": "tenant_demo",
    "TRACKING_SITE_ID": "site_demo",
    "TRACKING_PREVIEW_NON_PAYMENT_PROOF": "true",
    "TRACKING_PAGES_SOURCE_SHA": "17d0b3d266ab0366be30d1612d2e41d03e35e5ee",
    "TRACKING_POLICY_VERSION": "2026-08-04",
    "TRACKING_REGION": "US",
    "TRACKING_CONTEXT_SIGNING_KEY_ID_CURRENT": "preview-current",
    "TRACKING_COOKIE_SIGNING_KEY_ID_CURRENT": "preview-current",
    "TRACKING_PAGES_BRIDGE_KEY_ID_CURRENT": "pages-current",
    "TRACKING_MIGRATION_SET_SHA": "REPLACE_WITH_REVIEWED_MIGRATION_SET_SHA",
    "TRACKING_RELEASE_SHA": "REPLACE_WITH_REVIEWED_RELEASE_SHA",
    "TRACKING_IP_RATE_LIMIT": "60",
    "TRACKING_VISITOR_RATE_LIMIT": "120",
    "TRACKING_TENANT_RATE_LIMIT": "10000",
    "TRACKING_QUEUE_BUDGET_PER_MINUTE": "10000",
    "TRACKING_META_BUDGET_PER_MINUTE": "5000",
    "TRACKING_EVENT_DELIVERY_BUDGET": "5",
    "TRACKING_META_SPEND_LIMIT_MICROS_PER_MINUTE": "1000000000",
    "TRACKING_META_EVENT_COST_MICROS": "1",
    "TRACKING_CLEANUP_BATCH_SIZE": "1500",
    "TRACKING_FUNNEL_SENDER_MANIFEST": "{\"funnels\":{\"owned-funnel-builder\":{\"meta\":false,\"tinybird\":false}}}",
    "EVENTS_DLQ_NAME": "maestro-events-preview-dlq",
  },
  "env": {
    "production": {
      "name": "maestro-first-party-events-live",
      "d1_databases": [
        {
          "binding": "TRACKING_DB",
          "database_name": "maestro-tracking-live",
          "database_id": "replace-with-live-tracking-d1-id",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "maestro-events-live" },
          { "binding": "EVENTS_DLQ", "queue": "maestro-events-live-dlq" },
        ],
        "consumers": [
          {
            "queue": "maestro-events-live",
            "max_batch_size": 50,
            "max_batch_timeout": 30,
            "max_retries": 5,
            "retry_delay": 15,
            "max_concurrency": 4,
            "dead_letter_queue": "maestro-events-live-dlq",
          },
          {
            "queue": "maestro-events-live-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 0,
            "max_concurrency": 1,
          },
        ],
      },
      "vars": {
        "TRACKING_ENVIRONMENT": "live",
        "TRACKING_CONTEXT_SIGNING_KEY_ID_CURRENT": "live-current",
        "TRACKING_MIGRATION_SET_SHA": "REPLACE_WITH_REVIEWED_MIGRATION_SET_SHA",
        "TRACKING_RELEASE_SHA": "REPLACE_WITH_REVIEWED_RELEASE_SHA",
        "TRACKING_QUEUE_BUDGET_PER_MINUTE": "10000",
        "TRACKING_META_BUDGET_PER_MINUTE": "5000",
        "TRACKING_EVENT_DELIVERY_BUDGET": "5",
        "TRACKING_META_SPEND_LIMIT_MICROS_PER_MINUTE": "1000000000",
        "TRACKING_META_EVENT_COST_MICROS": "1",
        "TRACKING_CLEANUP_BATCH_SIZE": "1500",
        "TRACKING_FUNNEL_SENDER_MANIFEST": "{\"funnels\":{\"owned-funnel-builder\":{\"meta\":false,\"tinybird\":false}}}",
        "EVENTS_DLQ_NAME": "maestro-events-live-dlq",
      },
    },
  },
}
