{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owned-funnel.invalid/schemas/capture-manifest.schema.json",
  "title": "Current visual evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "capturedAt",
    "playwrightVersion",
    "chromiumVersion",
    "configFingerprint",
    "distDirectory",
    "smokeReceiptPath",
    "environment",
    "routes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "toolVersion": { "const": "1.0.0" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "playwrightVersion": { "type": "string", "minLength": 1 },
    "chromiumVersion": { "type": "string", "minLength": 1 },
    "configFingerprint": { "$ref": "#/$defs/sha256" },
    "distDirectory": { "type": "string", "minLength": 1 },
    "smokeReceiptPath": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "timezoneId", "colorScheme", "reducedMotion", "deviceScaleFactor"],
      "properties": {
        "locale": { "const": "en-US" },
        "timezoneId": { "const": "UTC" },
        "colorScheme": { "const": "light" },
        "reducedMotion": { "const": "reduce" },
        "deviceScaleFactor": { "const": 1 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "buildFingerprint", "captures"],
        "properties": {
          "route": { "type": "string", "pattern": "^/" },
          "buildFingerprint": { "$ref": "#/$defs/sha256" },
          "captures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route",
                "profile",
                "kind",
                "path",
                "width",
                "height",
                "byteSize",
                "sha256"
              ],
              "properties": {
                "route": { "type": "string", "pattern": "^/" },
                "profile": { "enum": ["desktop", "tablet", "mobile"] },
                "kind": { "enum": ["first-fold", "full-page"] },
                "path": { "type": "string", "minLength": 1 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 },
                "byteSize": { "type": "integer", "minimum": 1 },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
