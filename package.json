{
  "name": "owned-funnel-builder",
  "description": "An agent-ready, conversion-focused funnel builder you own forever.",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "editor": "astro dev --config astro.config.editor.mjs --open /keystatic",
    "start": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build",
    "deploy": "npm run build && wrangler pages deploy dist/client --project-name owned-funnel-builder --branch main",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "offer:new": "node scripts/new-offer.mjs",
    "check:kpis": "node .claude/scripts/check-kpis.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.1",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.1.6",
    "dodopayments-checkout": "^1.9.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.115.0"
  }
}
